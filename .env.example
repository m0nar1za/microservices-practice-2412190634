# 不要直接复制本文件为 .env。
# 在仓库根目录执行: bash scripts/init-env.sh
# 脚本会生成随机 MySQL 密码和合法的 Nacos Base64 Token。

MYSQL_ROOT_PASSWORD=change-me
USER_DB_PASSWORD=change-me
PRODUCT_DB_PASSWORD=change-me
ORDER_DB_PASSWORD=change-me

# Nacos 鉴权
# NACOS_AUTH_TOKEN 必须是 Base64，解码后至少 32 字节
NACOS_AUTH_TOKEN=change-me-to-base64
NACOS_AUTH_IDENTITY_KEY=courseServerIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-to-hex
NACOS_PASSWORD=nacos
